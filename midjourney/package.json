{
  "name": "@egaki/midjourney",
  "version": "0.0.1",
  "type": "module",
  "description": "Midjourney SDK powered by Playwriter browser automation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./explore.server": {
      "types": "./src/explore-image.server.tsx",
      "default": "./src/explore-image.server.tsx"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/egaki.git",
    "directory": "midjourney"
  },
  "homepage": "https://github.com/remorses/egaki#readme",
  "bugs": {
    "url": "https://github.com/remorses/egaki/issues"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "midjourney",
    "ai",
    "image",
    "generation",
    "sdk",
    "playwriter",
    "browser",
    "automation"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "@xmorse/playwright-core": "^1.52.3"
  },
  "peerDependencies": {
    "egaki": ">=0.6.0",
    "playwriter": ">=0.3.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "egaki": {
      "optional": true
    },
    "playwriter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "egaki": "workspace:^",
    "rimraf": "^6.0.1",
    "vitest": "^4.1.8"
  }
}
